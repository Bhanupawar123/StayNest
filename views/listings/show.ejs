<% layout("/layouts/boilerplate") %>

<div class="container my-4">
  <div class="show-page-wrapper">
    <!-- LISTING CARD -->
    <div class="card show-card border-0 shadow-lg mb-5">
      <img 
        src="<%= listing.image.url%>" 
        class="card-img-top show-img"
        alt="<%= listing.title %> image"
        style="height: 300px; object-fit: cover;"
      />

      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h2 class="fw-bold mb-0"><%= listing.title %></h2>
          <h4 class="text-primary mb-0">₹ <%= listing.price.toLocaleString("en-IN") %> <small>/night</small></h4>
        </div>

        <p class="text-muted mb-2">
          <i class="fas fa-user me-1"></i>
          <%= listing.owner?.username || listing.owner?.email || 'Unknown owner' %>
        </p>
        
        <p class="card-text mb-3"><%= listing.description %></p>

        <div class="row mb-4">
          <div class="col-md-6">
            <p class="mb-1"><i class="fas fa-map-marker-alt me-2 text-primary"></i><%= listing.location %></p>
            <p class="text-muted mb-0"><%= listing.country %></p>
          </div>
        </div>
        
        <!-- OWNER ACTIONS -->
        <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">
              <i class="fas fa-edit me-1"></i>Edit
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">
                <i class="fas fa-trash me-1"></i>Delete
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <hr class="my-5">

    <!-- REVIEW FORM -->
    <div class="review-section mb-5">
      <h2 class="mb-4 fw-bold">
        <i class="fas fa-star text-warning me-2"></i>
        Leave a Review
      </h2>

      <% if (currentUser) { %>
        <div class="card border-0 shadow-lg p-4 review-form">
          <form method="POST" action="/listings/<%= listing._id %>/reviews">
            
            <!-- STAR RATING -->
            <div class="mb-4">
              <label class="form-label fw-semibold mb-3 d-block">Your Rating</label>
              <div class="star-rating-container">
                <div class="star-rating">
                  <input type="radio" name="review[rating]" id="star5" value="5" required>
                  <label for="star5" title="Excellent">★</label>
                  
                  <input type="radio" name="review[rating]" id="star4" value="4">
                  <label for="star4" title="Very Good">★</label>
                  
                  <input type="radio" name="review[rating]" id="star3" value="3">
                  <label for="star3" title="Good">★</label>
                  
                  <input type="radio" name="review[rating]" id="star2" value="2">
                  <label for="star2" title="Poor">★</label>
                  
                  <input type="radio" name="review[rating]" id="star1" value="1">
                  <label for="star1" title="Very Poor">★</label>
                </div>
                <small class="text-muted mt-2">Select your rating above</small>
              </div>
            </div>

            <!-- COMMENT -->
            <div class="mb-4">
              <label for="comment" class="form-label fw-semibold mb-2">Your Comments</label>
              <textarea 
                class="form-control border-0 shadow-sm p-3" 
                name="review[comment]" 
                id="comment" 
                rows="5"
                placeholder="Share your experience about this listing. What did you like? Any suggestions?"
                style="border-radius: 12px; resize: vertical;"
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-dark px-5 py-2 fw-semibold border-0 shadow-lg">
              <i class="fas fa-paper-plane me-2"></i>
              Submit Review
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="alert alert-info border-0 shadow-sm p-4">
          <div class="d-flex align-items-center">
            <i class="fas fa-lock fa-2x me-3 text-primary"></i>
            <div>
              <h5 class="mb-2">Login to Write Review</h5>
              <p class="mb-0">Please <a href="/login" class="alert-link fw-semibold">log in</a> to share your experience.</p>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <hr class="my-5">

    <!-- ALL REVIEWS -->
    <div class="all-reviews-section">
      <h3 class="mb-4 fw-bold">
        <i class="fas fa-comments text-primary me-2"></i>
        Reviews (<%= listing.reviews.length %>)
      </h3>

      <% if (listing.reviews.length > 0) { %>
        <div class="row g-4">
          <% for (let review of listing.reviews) { %>
            <div class="col-lg-6 col-xl-4">
              <div class="card review-card h-100 border-0 shadow-sm hover-shadow">
                <div class="card-body p-4">
                  
                  <!-- RATING STARS -->
                  <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                      <% for(let i = 1; i <= review.rating; i++) { %>
                        <i class="fas fa-star text-warning"></i>
                      <% } %>
                      <% for(let i = review.rating + 1; i <= 5; i++) { %>
                        <i class="far fa-star text-muted"></i>
                      <% } %>
                    </div>
                    <small class="text-muted">(<%= review.rating %>/5)</small>
                  </div>

                  <!-- REVIEW CONTENT -->
                  <p class="card-text mb-3 lh-lg"><%= review.comment %></p>

                  <!-- REVIEW META -->
                  <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                      <i class="fas fa-user-circle me-1"></i>
                      <%= review.author?.username || 'Anonymous' %>
                    </small>
                    <small class="text-muted">
                      <i class="fas fa-clock me-1"></i>
                      <%= new Date(review.createdAt).toLocaleDateString("en-IN", { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric' 
                      }) %>
                    </small>
                  </div>

                  <!-- DELETE BUTTON -->
                  <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                    <div class="mt-3">
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1" 
                                onclick="return confirm('Delete your review?')">
                          <i class="fas fa-trash me-1"></i>Delete
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="fas fa-comments fa-3x text-muted mb-3 opacity-50"></i>
          <h5 class="text-muted">No reviews yet</h5>
          <p class="text-muted">Be the first to share your experience!</p>
        </div>
      <% } %>
    </div>
  </div>
</div>